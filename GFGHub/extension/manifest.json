{
    "manifest_version": 3,
    "name": "GFGHub Sync",
    "version": "1.0.0",
    "description": "Extract GeeksforGeeks solutions and push them to GitHub",
    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "http://localhost:5000/*",
        "https://www.geeksforgeeks.org/*"
    ],
    "background": {
        "service_worker": "src/background/background.js"
    },
    "action": {
        "default_popup": "src/popup/Popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.geeksforgeeks.org/*"
            ],
            "js": [
                "src/content/gfgDetector.js"
            ]
        }
    ]
}