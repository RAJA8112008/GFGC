{
  "name": "gfg-hub",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "extension"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm --filter ./client run dev\" \"pnpm --filter ./server run dev\"",
    "build": "pnpm --filter ./client run build && pnpm --filter ./extension run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "octokit": "^5.0.5",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12"
  }
}